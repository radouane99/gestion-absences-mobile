{
  "name": "gestion-absences",
  "version": "1.0.0",
  "description": "Application mobile universitaire de gestion des absences - React Native, Expo, TypeScript et SQLite",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:absences": "node scripts/test-absences.cjs",
    "test:justificatifs": "node scripts/test-justificatifs.cjs",
    "test": "npm run test:absences && npm run test:justificatifs",
    "format": "prettier --write src scripts docs README.md TEST-EXPO-GO.md package.json tsconfig.json app.json eslint.config.js .prettierrc.json",
    "format:check": "prettier --check src scripts docs README.md TEST-EXPO-GO.md package.json tsconfig.json app.json eslint.config.js .prettierrc.json",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "private": true
}
